@page "{id:int}"
@model HomeLibraryRazorPages.Pages.Books.DetailsModel
@{
    ViewData["Title"] = Model.Book?.Title ?? "Книга";
}

@if (Model.Book == null)
{
    <div class="alert alert-warning">Книга не найдена.</div>
}
else
{
    <h2>@Model.Book.Title</h2>
    <hr />

    <div class="row">
        <div class="col-md-8">
            <dl class="row">
                <dt class="col-sm-3">Автор</dt>
                <dd class="col-sm-9">@Model.Book.Author</dd>

                <dt class="col-sm-3">Год издания</dt>
                <dd class="col-sm-9">@(Model.Book.Year?.ToString() ?? "—")</dd>

                <dt class="col-sm-3">Кол-во страниц</dt>
                <dd class="col-sm-9">@(Model.Book.Pages?.ToString() ?? "—")</dd>

                <dt class="col-sm-3">Жанр</dt>
                <dd class="col-sm-9">@(Model.Book.Genre ?? "—")</dd>

                <dt class="col-sm-3">ISBN</dt>
                <dd class="col-sm-9">@(Model.Book.ISBN ?? "—")</dd>

                <dt class="col-sm-3">Описание</dt>
                <dd class="col-sm-9">@(Model.Book.Description ?? "—")</dd>

                <dt class="col-sm-3">Создано</dt>
                <dd class="col-sm-9">@Model.Book.CreatedAt.ToString("dd.MM.yyyy HH:mm")</dd>

                <dt class="col-sm-3">Обновлено</dt>
                <dd class="col-sm-9">@Model.Book.UpdatedAt.ToString("dd.MM.yyyy HH:mm")</dd>
            </dl>
        </div>
    </div>

    @if (Model.Book.TableOfContentsParsed != null)
    {
        <h4 class="mt-4">Оглавление</h4>
        <div class="card">
            <div class="card-body">
                <div id="toc-display"></div>
            </div>
        </div>
    }

    <div class="mt-3">
        <a asp-page="Edit" asp-route-id="@Model.Book.Id" class="btn btn-primary">Изменить</a>
        <a asp-page="ExportXml" asp-route-id="@Model.Book.Id" class="btn btn-outline-success">Экспорт XML</a>
        <a asp-page="Index" class="btn btn-secondary">Назад к каталогу</a>
    </div>
}

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var tocRaw = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Book?.TableOfContentsXml ?? ""));
            if (!tocRaw) return;

            var parser = new DOMParser();
            var doc = parser.parseFromString(tocRaw, 'text/xml');
            var container = document.getElementById('toc-display');

            function renderNode(node, parentUl) {
                var chapters = node.querySelectorAll(':scope > Chapter');
                chapters.forEach(function (ch) {
                    var li = document.createElement('li');
                    var num = ch.getAttribute('number') || '';
                    var title = ch.getAttribute('title') || 'Без названия';
                    var pages = ch.getAttribute('pages');
                    li.innerHTML = '<strong>' + num + '. ' + title + '</strong>' +
                        (pages ? ' <span class="text-muted">(' + pages + ' стр.)</span>' : '');

                    var sections = ch.querySelectorAll(':scope > Section');
                    if (sections.length > 0) {
                        var subUl = document.createElement('ul');
                        sections.forEach(function (sec) {
                            var subLi = document.createElement('li');
                            var sTitle = sec.getAttribute('title') || 'Без названия';
                            var sPages = sec.getAttribute('pages');
                            subLi.textContent = sTitle + (sPages ? ' (' + sPages + ' стр.)' : '');
                            subUl.appendChild(subLi);
                        });
                        li.appendChild(subUl);
                    }
                    parentUl.appendChild(li);
                });
            }

            var rootUl = document.createElement('ul');
            renderNode(doc.documentElement, rootUl);
            container.appendChild(rootUl);
        });
    </script>
}
