@model IEnumerable<Book>

@{
    ViewData["Title"] = "Каталог книг";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Каталог книг</h2>
    <div>
        <a asp-action="ExportXml" class="btn btn-outline-success me-2">Экспорт XML</a>
        <a asp-action="Create" class="btn btn-success">Добавить книгу</a>
    </div>
</div>

<form asp-action="Index" method="get" class="mb-3">
    <div class="input-group">
        <input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="Поиск по названию или автору..." />
        <button type="submit" class="btn btn-outline-primary">Найти</button>
        @if (ViewBag.Search != null)
        {
            <a asp-action="Index" class="btn btn-outline-secondary">Сбросить</a>
        }
    </div>
</form>

@if (!Model.Any())
{
    <div class="alert alert-info">Книги не найдены.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>#</th>
                    <th>Название</th>
                    <th>Автор</th>
                    <th>Год</th>
                    <th>Страниц</th>
                    <th>Жанр</th>
                    <th>Действия</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var book in Model)
                {
                    <tr>
                        <td>@book.Id</td>
                        <td><a asp-action="Details" asp-route-id="@book.Id">@book.Title</a></td>
                        <td>@book.Author</td>
                        <td>@book.Year</td>
                        <td>@book.Pages</td>
                        <td>@book.Genre</td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@book.Id" class="btn btn-sm btn-outline-primary">Изменить</a>
                            <a asp-action="Delete" asp-route-id="@book.Id" class="btn btn-sm btn-outline-danger">Удалить</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
